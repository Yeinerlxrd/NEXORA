# Local Docker Compose settings. This file is a template, not production config.
APP_NAME="NEXORA"
APP_ENV=local
APP_DEBUG=false
# Empty marker: generate a real key with Laravel before starting the app.
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Bogota

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nexora
DB_USERNAME=nexora
# Generate both values locally; do not use these examples in production.
DB_PASSWORD=
DB_ROOT_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
# Keep the backend private: NGINX replaces X-Forwarded-For with its peer address before forwarding requests.
# Restrict this trust list to the NGINX peer/network if the backend is exposed outside the Compose network.
TRUSTED_PROXIES=*
# Same-origin frontend/API needs no CORS allow-list. Add only exact trusted origins if separated.
CORS_ALLOWED_ORIGINS=

VITE_API_URL=/api

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@nexora.local"
MAIL_FROM_NAME="NEXORA"
